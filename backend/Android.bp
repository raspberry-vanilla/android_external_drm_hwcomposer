soong_config_module_type {
    name: "drm_hwcomposer_backend_defaults",
    module_type: "cc_defaults",
    config_namespace: "DRMHWC",
    variables: [
        "backend",
        "desktop_variant",
    ],
    properties: [
        "header_libs",
        "shared_libs",
        "srcs",
    ],
}

soong_config_string_variable {
    name: "backend",
    values: ["sdm"],
}

soong_config_string_variable {
    name: "desktop_variant",
    values: [
        "stub",
    ],
}

cc_library_headers {
    name: "drm_hwcomposer_sdm_stub_headers",
    vendor: true,
    export_include_dirs: ["sdm/stubs/include"],
}

drm_hwcomposer_backend_defaults {
    name: "sdm_backend",
    srcs: [
        "backend/SdmBackend.cpp",
        "backend/sdm/SdmAtomicStateManager.cpp",
        "backend/sdm/SdmCompositionPlanner.cpp",
        "backend/sdm/SdmDebugCallback.cpp",
        "backend/sdm/SdmHotplugHandler.cpp",
        "backend/sdm/SdmToConnectorMapper.cpp",
        "backend/sdm/SnapAllocHandle.cpp",
        "backend/sdm/sdm_error.cpp",
    ],
    soong_config_variables: {
        desktop_variant: {
            stub: {
                srcs: [
                    "backend/sdm/stubs/sdm_stubs.cpp",
                ],
                header_libs: [
                    "drm_hwcomposer_sdm_stub_headers",
                ],
            },
            conditions_default: {
                srcs: [
                    "backend/sdm/stubs/sdm_stubs.cpp",
                ],
                header_libs: [
                    "drm_hwcomposer_sdm_stub_headers",
                ],
            },
        },
    },
}
